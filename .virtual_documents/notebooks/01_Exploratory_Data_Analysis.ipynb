import matplotlib.pyplot as plt
import seaborn as sns

features = ['Air temperature [K]', 'Process temperature [K]', 'Rotational speed [rpm]', 'Torque [Nm]', 'Tool wear [min]']
target = 'Machine failure'

fig, axes = plt.subplots(2, 3, figsize=(16, 8))
axes = axes.flatten()

for i, feature in enumerate(features):
    sns.boxplot(
        data=df,
        x=target,
        y=feature,
        ax=axes[i]
    )
    axes[i].set_title(f'{feature} vs {target}')

fig.delaxes(axes[-1])

plt.tight_layout()
plt.show()








plt.figure(figsize=(10, 8))

corr = df.select_dtypes(include=np.number).corr()

sns.heatmap(
    corr,
    annot=True,
    fmt=".2f",
    cmap="coolwarm",
    linewidths=0.5
)

plt.title("Correlation Matrix")

plt.show()





failure_modes = ["TWF", "HDF", "PWF", "OSF", "RNF"]

failure_counts = df[failure_modes].sum().sort_values(ascending=False)

failure_counts


plt.figure(figsize=(8,5))

sns.barplot(
    x=failure_counts.index,
    y=failure_counts.values
)

plt.title("Distribution of Failure Types")
plt.xlabel("Failure Type")
plt.ylabel("Number of Failures")

plt.show()














df["Temperature_Difference"] = (
    df["Process temperature [K]"] -
    df["Air temperature [K]"]
)





df["Mechanical_Load"] = (
    df["Torque [Nm]"] *
    df["Rotational speed [rpm]"]
)





df["Wear_Stress"] = (
    df["Tool wear [min]"] *
    df["Torque [Nm]"]
)





df["Wear_Heat"] = (
    df["Tool wear [min]"] *
    df["Process temperature [K]"]
)


new_features = [
    "Temperature_Difference",
    "Mechanical_Load",
    "Wear_Stress",
    "Wear_Heat"
]

df[new_features].head()


df[new_features].describe().T


plt.figure(figsize=(8,6))

sns.heatmap(
    df[new_features + ["Machine failure"]].corr(),
    annot=True,
    cmap="coolwarm",
    fmt=".2f"
)

plt.title("Correlation of Engineered Features")
plt.show()





df.to_csv("../data/processed/featured_data.csv", index=False)
